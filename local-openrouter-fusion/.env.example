OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=240.0

APP_URL=http://localhost:8000
APP_NAME="Local OpenRouter Fusion Orchestrator"

SERVICE_API_KEYS=local-secret-key-1,local-secret-key-2

RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_MINUTE=10

MAX_PROMPT_CHARS=24000
MAX_ANALYSIS_MODELS=8
MAX_MODEL_CONCURRENCY=8
MAX_CANDIDATE_CHARS_PER_MODEL=12000
MAX_FINAL_CONTEXT_CHARS=48000

CACHE_TTL_SECONDS=600
LOCAL_TOKEN_BUDGET_PER_KEY=1000000

DEFAULT_ANALYSIS_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4.1,google/gemini-2.5-pro,x-ai/grok-4
DEFAULT_JUDGE_MODEL=anthropic/claude-opus-4.1
DEFAULT_CRITIC_MODEL=anthropic/claude-sonnet-4.5

ALLOWED_MODELS=

# --- Local CLI model adapters (optional) ---
# Mix locally-installed CLI assistants (e.g. Claude Code, OpenAI Codex CLI)
# into the fusion pipeline alongside remote OpenRouter models.
#
# Use the model ids "local:claude-code" or "local:codex" in analysis_models
# / judge_model / critic_model (or inside the OpenAI-compat model name, e.g.
#   local-fusion-code:local:claude-code+openai/gpt-4.1@anthropic/claude-opus-4.1
# ).
#
# Disable a local adapter by leaving its CMD empty.
LOCAL_MODEL_TIMEOUT_SECONDS=180

LOCAL_CLAUDE_CODE_CMD=claude
# Comma-separated argv (NOT a shell string). The prompt is written to stdin.
LOCAL_CLAUDE_CODE_ARGS=-p,--output-format,text

LOCAL_CODEX_CMD=codex
LOCAL_CODEX_ARGS=exec,--no-stream

LOCAL_GEMINI_CMD=gemini
LOCAL_GEMINI_ARGS=-p
